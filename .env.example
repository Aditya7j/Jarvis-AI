# FREE Gemini API Key - IMPORTANT: must start with "AIza"
# Get yours here: https://aistudio.google.com/app/apikey
# (Keys that start with "AQ." are NOT valid Gemini keys)
# Secrets are read server-side only. Never use NEXT_PUBLIC_* for secrets.
GEMINI_API_KEY=

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local AI (optional, free)
# Set this only if Ollama is not on the default port/host.
OLLAMA_BASE_URL=http://localhost:11434

# Model overrides (optional). Defaults are auto-selected.
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Recommended for CPU-only machines (fastest). JARVIS auto-prefers small models
# like qwen3:1.8b or llama3.2:3b when this is left empty.
# OLLAMA_MODEL=qwen3:1.8b

# AI Router: role-based model selection (Qwen3 = reasoning, Gemma 3 = vision).
# Install Qwen3 with "ollama pull qwen3:latest" and Gemma 3 (for camera/screen
# understanding) with "ollama pull gemma3:4b". Leave GEMMA3_MODEL empty to
# auto-detect any installed multimodal model.
QWEN3_MODEL=qwen3:latest
# GEMMA3_MODEL=gemma3:4b

# Owner Profile & Memory (optional). Defaults to ./data/memory
# MEMORY_DATA_DIR=./data/memory

# Timeouts in milliseconds (optional)
# AI_REQUEST_TIMEOUT_MS=60000
# AI_HEALTH_TIMEOUT_MS=10000
# AI_LOG_LEVEL=info

# Agent orchestration: max tool-call iterations Qwen3 may take before answering
# (time, memory search, remember, ...). Higher = more capable agents, slower.
# AI_MAX_TOOL_ITERATIONS=4

# Voice (free tiers available)
ELEVENLABS_API_KEY=
# Used for speech-to-text in browsers without built-in voice input
# (Firefox/Safari). Chrome and Edge use the built-in recognizer instead.
# Get a key here: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Local speech-to-text (Whisper). Auto-detected; falls back to Deepgram,
# then to the browser's built-in recognizer. STT_MODE=auto|whisper|deepgram|browser
# WHISPER_ENABLED=true
# WHISPER_COMMAND=whisper
# WHISPER_SERVER_URL=
# WHISPER_MODEL=base

# Local text-to-speech (Piper). Auto-detected; falls back to the browser's
# SpeechSynthesis. TTS_MODE=auto|piper|browser
# PIPER_ENABLED=true
# PIPER_COMMAND=piper
# PIPER_SERVER_URL=
# PIPER_VOICE=en_US-lessac-medium

# Server
PORT=3001
NODE_ENV=development
